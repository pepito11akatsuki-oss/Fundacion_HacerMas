@model FundacionHacerMasWeb.Models.RegistroCitaViewModel
@{
    ViewData["Title"] = "Registro y Agendamiento";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-light text-secondary text-uppercase" style="letter-spacing: 1px;">Gestión de Ingreso y Citas</h3>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-0">Volver al Panel</a>
    </div>

    <form asp-action="Agendar" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-0"></div>

        <div class="row g-4">
            <!-- Bloque 1: Datos del Paciente -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-0 h-100 border-start border-4 border-secondary">
                    <div class="card-body p-4">
                        <h5 class="text-uppercase text-secondary mb-4 fs-6 fw-bold">Información del Paciente</h5>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Nombres" class="form-label text-muted small text-uppercase">Nombres</label>
                                <input asp-for="Nombres" class="form-control rounded-0 bg-light border-0" required />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Apellidos" class="form-label text-muted small text-uppercase">Apellidos</label>
                                <input asp-for="Apellidos" class="form-control rounded-0 bg-light border-0" required />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Correo" class="form-label text-muted small text-uppercase">Correo Electrónico</label>
                                <input asp-for="Correo" type="text" class="form-control rounded-0 bg-light border-0" required />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="FechaNacimiento" class="form-label text-muted small text-uppercase">Fecha de Nacimiento</label>
                                <input asp-for="FechaNacimiento" type="date" class="form-control rounded-0 bg-light border-0" required />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ContactoEmergencia" class="form-label text-muted small text-uppercase">Contacto de Emergencia</label>
                                <input asp-for="ContactoEmergencia" class="form-control rounded-0 bg-light border-0" required />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="TelefonoEmergencia" class="form-label text-muted small text-uppercase">Teléfono de Emergencia</label>
                                <input asp-for="TelefonoEmergencia" class="form-control rounded-0 bg-light border-0" required />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bloque 2: Programación Médica -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-0 h-100 border-start border-4 border-primary">
                    <div class="card-body p-4">
                        <h5 class="text-uppercase text-primary mb-4 fs-6 fw-bold">Programación de Cita</h5>

                        <div class="mb-4">
                            <label asp-for="IdMedico" class="form-label text-muted small text-uppercase">Médico Asignado y Horario</label>
                            <select asp-for="IdMedico" class="form-select rounded-0 bg-light border-0" asp-items="ViewBag.IdMedico" required>
                                <option value="">-- Seleccione Profesional Disponible --</option>
                            </select>
                            <span asp-validation-for="IdMedico" class="text-danger small"></span>
                        </div>
                        <div class="row mb-4 g-3">
                            <div class="col-md-6">
                                <label class="form-label text-muted small text-uppercase fw-bold">1. Seleccione Fecha</label>
                                <input type="date" id="FechaConsulta" class="form-control form-control-lg rounded-0 bg-light border-0 border-bottom border-2 border-primary" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label text-muted small text-uppercase fw-bold">2. Seleccione Horario</label>
                                <select id="HoraConsulta" class="form-select form-select-lg rounded-0 bg-light border-0 border-bottom border-2 border-primary" disabled required>
                                    <option value="">-- Elija Médico y Fecha primero --</option>
                                </select>
                            </div>
                        </div>
                        <!-- C# sigue recibiendo la variable FechaHora normal a través de este campo oculto -->
                        <input type="hidden" asp-for="FechaHora" id="FechaHoraOculta" />
                        <span asp-validation-for="FechaHora" class="text-danger small d-block"></span>
                        <div class="mb-4">
                            <label asp-for="MotivoConsulta" class="form-label text-muted small text-uppercase">Motivo de la Consulta</label>
                            <textarea asp-for="MotivoConsulta" class="form-control rounded-0 bg-light border-0" rows="3" maxlength="200" required></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end mt-4">
            <button type="submit" class="btn btn-primary rounded-0 px-5 py-2 text-uppercase fw-bold">Confirmar Registro y Cita</button>
        </div>
    </form>
    <script>
            document.addEventListener("DOMContentLoaded", function () {
                const medicoSelect = document.getElementById("IdMedico");
                const fechaInput = document.getElementById("FechaConsulta");
                const horaSelect = document.getElementById("HoraConsulta");
                const fechaHoraOculta = document.getElementById("FechaHoraOculta");
                const form = document.querySelector("form");

                function cargarHorarios() {
                    const idMedico = medicoSelect.value;
                    const fecha = fechaInput.value;

                    // Si ya seleccionó al médico y la fecha, buscamos los horarios
                    if (idMedico && fecha) {
                        horaSelect.innerHTML = '<option value="">Consultando agenda...</option>';
                        horaSelect.disabled = true;

                        // Llamada invisible a la base de datos
                        fetch(`/Citas/ObtenerHorariosDisponibles?idMedico=${idMedico}&fecha=${fecha}`)
                            .then(response => response.json())
                            .then(data => {
                                horaSelect.innerHTML = '<option value="">-- Seleccione un Horario --</option>';

                                if (data.length === 0) {
                                    horaSelect.innerHTML = '<option value="">Sin turnos configurados</option>';
                                } else {
                                    // Construir la lista
                                    data.forEach(item => {
                                        const option = document.createElement("option");
                                        option.value = item.hora;

                                        if (item.ocupado) {
                                            option.text = item.hora + " - NO DISPONIBLE";
                                            option.disabled = true; // Bloquea la selección
                                            option.style.color = "#dc3545"; // Color rojo
                                            option.style.fontWeight = "bold";
                                        } else {
                                            option.text = item.hora + " - Disponible";
                                        }

                                        horaSelect.appendChild(option);
                                    });
                                    horaSelect.disabled = false; // Activamos el candado
                                }
                            })
                            .catch(error => console.error("Error cargando horarios:", error));
                    } else {
                        horaSelect.innerHTML = '<option value="">-- Elija Médico y Fecha primero --</option>';
                        horaSelect.disabled = true;
                    }
                }

                // Cada vez que cambia el médico o la fecha, recalculamos todo
                medicoSelect.addEventListener("change", cargarHorarios);
                fechaInput.addEventListener("change", cargarHorarios);

                // Al presionar "Guardar Cita", unimos la fecha y la hora para mandarlas a C#
                form.addEventListener("submit", function (e) {
                    if (fechaInput.value && horaSelect.value) {
                        fechaHoraOculta.value = fechaInput.value + "T" + horaSelect.value;
                    }
                });
            });
    </script>
</div>
