@model FundacionHacerMasWeb.Models.LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card shadow-sm border-0 rounded-0 border-top border-4 border-primary" style="width: 100%; max-width: 450px;">
        <div class="card-body p-5">
            <div class="text-center mb-5">
                <h4 class="text-secondary fw-bold text-uppercase" style="letter-spacing: 2px;">Fundación Hacer Más</h4>
                <p class="text-muted small text-uppercase">Portal de Acceso Institucional</p>
            </div>

            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-0 small"></div>

                <div class="mb-4">
                    <label asp-for="IdAcceso" class="form-label text-muted small text-uppercase fw-bold">ID de Empleado / Paciente</label>
                    <input asp-for="IdAcceso" class="form-control form-control-lg rounded-0 bg-light border-0" type="text" placeholder="Ej. E-000001 o P-000001" required autofocus />
                    <span asp-validation-for="IdAcceso" class="text-danger small"></span>
                </div>e

                <div class="mb-5">
                    <label asp-for="Password" class="form-label text-muted small text-uppercase fw-bold">Contraseña</label>
                    <div class="input-group">
                        <input asp-for="Password" id="loginPassword" class="form-control form-control-lg rounded-0 bg-light border-0" type="password" required />
                        <!-- El botón del ojito con diseño plano para mantener el minimalismo -->
                        <button class="btn btn-light rounded-0 border-0 bg-light text-muted" type="button" onclick="togglePassword('loginPassword', 'eyeIcon')">
                            <span id="eyeIcon">👁️</span>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 rounded-0 text-uppercase fw-bold" style="letter-spacing: 1px;">Ingresar al Sistema</button>
            </form>
        </div>
    </div>
</div>

<!-- Script para el ojito de la contraseña -->
<script>
    function togglePassword(inputId, iconId) {
        var input = document.getElementById(inputId);
        var icon = document.getElementById(iconId);
        if (input.type === "password") {
            input.type = "text";
            icon.innerText = "🙈";
        } else {
            input.type = "password";
            icon.innerText = "👁️";
        }
    }
</script>
