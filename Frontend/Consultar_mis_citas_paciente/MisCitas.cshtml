@model IEnumerable<FundacionHacerMasWeb.Models.Cita>
@{
    ViewData["Title"] = "Mi Expediente y Citas";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <div>
            <h3 class="fw-light text-dark text-uppercase" style="letter-spacing: 1px;">Mi Expediente y Citas</h3>
            <p class="text-muted small mb-0">Consulte el estado actual de sus citas médicas y su historial de atención.</p>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-0 text-uppercase fw-bold">Volver al Inicio</a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var cita in Model)
            {
                // Determinar colores según el estado de la cita
                string bordeColor = cita.Estado == "Programada" ? "border-primary" :
                                  (cita.Estado == "Atendida" ? "border-success" : "border-danger");

                string badgeColor = cita.Estado == "Programada" ? "bg-primary" :
                                                  (cita.Estado == "Atendida" ? "bg-dark" : "bg-danger");

                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-0 border-top border-4 @bordeColor">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <span class="badge @badgeColor rounded-0 text-uppercase mb-2">@cita.Estado</span>
                                    <h5 class="fw-bold mb-0 text-dark">@cita.FechaHora.ToLocalTime().ToString("dd MMMM yyyy")</h5>
                                    <small class="text-muted fw-bold">Hora: @cita.FechaHora.ToLocalTime().ToString("HH:mm") hrs</small>
                                </div>
                            </div>

                            <hr class="text-muted opacity-25">

                            <div class="mb-3">
                                <small class="text-muted text-uppercase fw-bold d-block" style="font-size: 0.7rem;">Médico Especialista</small>
                                <span class="text-dark fw-bold">Dr. @cita.Medico?.Usuario?.Nombres @cita.Medico?.Usuario?.Apellidos</span><br />
                                <small class="text-secondary">@cita.Medico?.Especialidad</small>
                            </div>

                            <div class="mb-3">
                                <small class="text-muted text-uppercase fw-bold d-block" style="font-size: 0.7rem;">Ubicación</small>
                                <span class="text-dark">Consultorio @cita.Medico?.Consultorio</span>
                            </div>

                            <div class="bg-light p-3 border-start border-2 border-secondary mt-3">
                                <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.7rem;">Motivo de Consulta</small>
                                <p class="small text-dark mb-0 fst-italic">"@cita.MotivoConsulta"</p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-0 text-center py-5 mt-4">
            <div class="card-body py-5">
                <h4 class="text-muted mb-3">No hay historial clínico</h4>
                <p class="text-secondary">Actualmente no tiene citas médicas programadas ni un historial de atención previo.</p>
            </div>
        </div>
    }
</div>
