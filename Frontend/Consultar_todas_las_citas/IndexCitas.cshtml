@model IEnumerable<FundacionHacerMasWeb.Models.Cita>
@{
    ViewData["Title"] = "Agenda General";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <div>
            <h3 class="fw-light text-dark text-uppercase" style="letter-spacing: 1px;">Agenda Institucional</h3>
            <p class="text-muted small mb-0">Control y monitoreo de citas médicas programadas.</p>
        </div>
        <a asp-action="Agendar" class="btn btn-dark rounded-0 px-4 text-uppercase fw-bold" style="letter-spacing: 0.5px;">+ Nuevo Ingreso</a>
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success rounded-0 border-0 border-start border-4 border-success small" role="alert">
            @TempData["MensajeExito"]
        </div>
    }

    <div class="card border-0 shadow-sm rounded-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary text-uppercase" style="font-size: 0.8rem; letter-spacing: 0.5px;">
                    <tr>
                        <th class="ps-4">Fecha y Hora</th>
                        <th>Paciente (Expediente)</th>
                        <th>Médico Asignado</th>
                        <th>Motivo</th>
                        <th>Estado</th>
                        <th class="text-end pe-4">Gestión</th>
                    </tr>
                </thead>
                <tbody class="text-dark small">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-secondary">@item.FechaHora.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@item.Paciente?.Usuario?.Nombres @item.Paciente?.Usuario?.Apellidos</td>
                                <td>Dr. @item.Medico?.Usuario?.Nombres @item.Medico?.Usuario?.Apellidos</td>
                                <td class="text-truncate" style="max-width: 150px;">@item.MotivoConsulta</td>
                                <td>
                                    <span class="badge bg-dark rounded-0 fw-normal">@item.Estado</span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Reagendar" asp-route-id="@item.IdCita" class="btn btn-sm btn-outline-dark rounded-0">Reagendar</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No hay citas programadas en el sistema.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-0 text-uppercase small">Volver al Panel Central</a>
    </div>
</div>
