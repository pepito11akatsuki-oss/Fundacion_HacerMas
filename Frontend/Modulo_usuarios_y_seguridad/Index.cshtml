@model IEnumerable<FundacionHacerMasWeb.Models.Usuario>
@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <div>
            <h3 class="fw-light text-dark text-uppercase" style="letter-spacing: 1px;">Directorio Institucional</h3>
            <p class="text-muted small mb-0">Gestión de credenciales de personal operativo y pacientes.</p>
        </div>
        <a asp-action="Create" class="btn btn-dark rounded-0 px-4 text-uppercase fw-bold" style="letter-spacing: 0.5px;">+ Nuevo Registro</a>
    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success rounded-0 border-0 border-start border-4 border-success small" role="alert">
            @TempData["Exito"]
        </div>
    }

    <div class="card border-0 shadow-sm rounded-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-secondary text-uppercase" style="font-size: 0.8rem; letter-spacing: 0.5px;">
                    <tr>
                        <th class="ps-4">ID de Acceso</th>
                        <th>Nombre Completo</th>
                        <th>Usuario (Correo)</th>
                        <th>Rol Asignado</th>
                        <th>Estado</th>
                        <th class="text-end pe-4">Administración</th>
                    </tr>
                </thead>
                <tbody class="text-dark small">
                    @foreach (var item in Model)
                    {
                        string idFormateado = "";

                        if (item.IdRol == 4) // Si es Paciente
                        {
                            var dic = ViewBag.PacientesDic as Dictionary<int, int>;
                            int idPacienteReal = (dic != null && dic.ContainsKey(item.IdUsuario)) ? dic[item.IdUsuario] : 0;
                            idFormateado = "P-" + idPacienteReal.ToString("D6");
                        }
                        else // Si es Empleado (Admin, Médico, Recepcionista)
                        {
                            idFormateado = "E-" + item.IdUsuario.ToString("D6");
                        }

                        <tr>
                            <td class="ps-4 fw-bold text-secondary">@idFormateado</td>
                            <td>@item.Nombres @item.Apellidos</td>
                            <td>@item.Correo</td>
                            <td>
                                <span class="badge bg-secondary rounded-0 fw-normal">@item.Rol.NombreRol</span>
                            </td>
                            <td>
                                @if (item.Activo)
                                {
                                    <span class="badge bg-dark rounded-0 fw-normal">Activo</span>
                                }
                                else
                                {

                                    <span class="badge bg-light text-muted border rounded-0 fw-normal">Inactivo</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Edit" asp-route-id="@item.IdUsuario" class="btn btn-sm btn-outline-dark rounded-0">Modificar</a>
                                @if (item.Activo)
                                {
                                    <a asp-action="Desactivar" asp-route-id="@item.IdUsuario" class="btn btn-sm btn-outline-secondary rounded-0 ms-1" onclick="return confirm('¿Proceder con la inhabilitación del acceso?');">Baja</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-0 text-uppercase small">Volver al Panel Central</a>
    </div>
</div>
